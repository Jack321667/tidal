# Dependencies
node_modules/

# Capacitor native projects — fully generated in CI (npx cap add ios/android)
# and re-patched by the ci/ scripts, so they are never committed.
/ios/
/android/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Android build output / signing (NEVER commit a keystore)
*.keystore
*.jks
keystore.properties

# macOS / misc
.DS_Store
*.log
npm-debug.log*

# Build artifacts
*.ipa
*.dSYM.zip
build/

# Code signing private key (NEVER commit)
cert_private_key.pem
